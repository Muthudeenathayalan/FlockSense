rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User documents with subcollections - owner only
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Allow full access to any subcollections under user's document
      // (farms, batches, dailyRecords, inventory, sheds, notifications, settings, etc.)
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Collection Group Queries for Daily Records
    match /{path=**}/dailyRecords/{recordId} {
      allow read, write: if request.auth != null && (
        resource == null ||
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid
      );
    }

    // Collection Group Queries for Batches
    match /{path=**}/batches/{batchId} {
      allow read, write: if request.auth != null && (
        resource == null ||
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid
      );
    }

    // Collection Group Queries for Medicine Records
    match /{path=**}/medicineRecords/{recordId} {
      allow read, write: if request.auth != null && (
        resource == null ||
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid
      );
    }

    // Collection Group Queries for Vaccine Records
    match /{path=**}/vaccineRecords/{recordId} {
      allow read, write: if request.auth != null && (
        resource == null ||
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid
      );
    }

    // Collection Group Queries for Sales Records
    match /{path=**}/salesRecords/{recordId} {
      allow read, write: if request.auth != null && (
        resource == null ||
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid
      );
    }

    // Collection Group Queries for Inventory Items
    match /{path=**}/inventoryItems/{itemId} {
      allow read, write: if request.auth != null && (
        resource == null ||
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid
      );
    }

    // Collection Group Queries for Sheds
    match /{path=**}/sheds/{shedId} {
      allow read, write: if request.auth != null && (
        resource == null ||
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid
      );
    }

    // Collection Group Queries for Calendar Events
    match /{path=**}/calendarEvents/{eventId} {
      allow read, write: if request.auth != null && (
        resource == null ||
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid
      );
    }

    // Prevent accessing any unauthorized collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
